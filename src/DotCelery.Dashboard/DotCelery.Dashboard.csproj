<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>DotCelery.Dashboard</RootNamespace>
    <Description>Web dashboard for monitoring DotCelery distributed task queue</Description>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotCelery.Core\DotCelery.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
    <EmbeddedResource
      Include="..\..\assets\dotcelery-logo.png"
      LogicalName="DotCelery.Dashboard.wwwroot.dotcelery-logo.png"
    />
    <EmbeddedResource Include="Pages\**\*.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.402" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotCelery.Tests.Unit" />
  </ItemGroup>
</Project>
