{
  "name": "dotcelery-dashboard-tooling",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write package.json package-lock.json tsconfig.json \"*.mts\" \"src/DotCelery.Dashboard/Frontend/**/*.{json,ts,tsx,css,html}\" \"eng/dashboard*.{cjs,mts}\"",
    "format:check": "prettier --check package.json package-lock.json tsconfig.json \"*.mts\" \"src/DotCelery.Dashboard/Frontend/**/*.{json,ts,tsx,css,html}\" \"eng/dashboard*.{cjs,mts}\"",
    "typecheck": "tsc --noEmit && tsc -p src/DotCelery.Dashboard/Frontend/tsconfig.json --noEmit",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "test:browser": "playwright test",
    "test": "node --test eng/dashboard-ui.test.cjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@tailwindcss/vite": "4.3.3",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "tailwindcss": "4.3.3"
  }
}
